# Local Docker Compose configuration. Never commit the real .env file.
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Media storage strategy: local (default, uploads/media) or cloudinary.
# When cloudinary, provide the standard URL from the Cloudinary dashboard:
# app.media.strategy=cloudinary
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
